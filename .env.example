# ── Next.js (.env.local) ─────────────────────────────────────────────────────
# Copy this file to .env.local. Never commit .env.local.

# Convex — written automatically by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — Dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing (leave as-is unless you move the auth pages).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Stripe price ID for the Pro plan (price_..., not prod_...).
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# ── Convex deployment env vars ───────────────────────────────────────────────
# These are NOT read from .env.local. Set them with `npx convex env set KEY value`
# or in the Convex dashboard → Settings → Environment Variables:
#
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#   STRIPE_SECRET_KEY         sk_test_... / sk_live_...
#   STRIPE_WEBHOOK_SECRET     whsec_... (from the Stripe webhook endpoint)
#   SITE_URL                  Where Stripe redirects back to, e.g. http://localhost:3000
